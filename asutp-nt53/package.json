{
  "name": "asutp-section-configurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Конфигуратор внешнего вида секций АСУ ТП (НТ53)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "deploy": "node scripts/deploy.mjs",
    "preview": "vite preview",
    "gen:library": "node scripts/gen-library.mjs",
    "gen:frame": "node scripts/gen-frame.mjs",
    "gen:library-table": "node scripts/library-table.mjs",
    "gen:xlsx": "node scripts/gen-xlsx.mjs",
    "channels": "node scripts/channels.mjs",
    "plan": "node scripts/plan.mjs",
    "export": "node scripts/export.mjs",
    "check": "node scripts/channels.mjs && node scripts/check-library.mjs && node scripts/check-photos.mjs && node scripts/check-plan.mjs",
    "check:plan": "node scripts/check-plan.mjs",
    "check:dxf": "node scripts/check-dxf.mjs",
    "check:pdf": "node scripts/check-pdf.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
